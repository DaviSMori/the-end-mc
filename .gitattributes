# Force LF line endings for all text files (both in repo and working directory)
* text=auto eol=lf

# Explicitly mark binary formats so Git never touches their bytes
*.zip binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
*.nbt binary
*.dat binary
*.dat_old binary
*.mca binary